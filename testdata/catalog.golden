          "description": "List the things, each its props with id and label, as a page {items, page, per_page, total}; filter and where keep the things that meet conditions, sort orders them, group-by gathers them into groups, per-page and page cut the result into pages (rows, never groups)",
          "kind": "application",
          "params": {
            "archived": {
              "type": "boolean",
              "description": "Include the archived things list.hide-archived hides by default"
            },
            "filter": {
              "type": "string",
              "description": "Keep the things that meet every condition: words prop=value, prop!=value, prop~value (contains), prop!~value, with a|b for alternatives; or the name of a saved prop filter for this noun. ANDed with where",
              "free": true
            },
            "group-by": {
              "type": "string",
              "description": "Gather the rows that share these props' values into groups (comma-separated props); each row names its group",
              "free": true
            },
            "group-sort": {
              "type": "string",
              "description": "Order the groups by group-by props, each prop[:desc] (default: the order the groups first appear in)",
              "free": true
            },
            "limit": {
              "type": "integer",
              "description": "At most this many rows: the first page of that size (0: every row)"
            },
            "page": {
              "type": "integer",
              "description": "The page to answer, from 1 (with per-page)"
            },
            "per-page": {
              "type": "integer",
              "description": "Rows per page, counting rows, never groups (0: one page of every row)"
            },
            "props": {
              "type": "string",
              "description": "The props each row holds besides id and label, comma-separated (default: every prop but secrets)"
            },
            "sort": {
              "type": "string",
              "description": "Order the rows by props, comma-separated, each prop[:desc]; ties keep the store's order",
              "free": true
            },
            "where": {
              "type": "string",
              "description": "prop=value pairs, comma- or space-separated: keep the things whose props equal every value",
              "free": true,
              "pairs": true
            }
          },
          "result": "rows",
          "rows": "ochazuke.modes",
          "positional": [
            "limit",
            "props",
            "where"
          ],
          "history": "fetch",
          "builtin": true,
          "standard": "list"
