          "destructive": false,
          "agent": "allow",
          "name": "set",
          "description": "Write a thing's props: props, an object of prop to value (a subset or all of them; @label, @owner and @archive name a prop by its role), or prop=value words; toggle flips one boolean prop; answers the thing after the write",
          "kind": "application",
          "params": {
            "changes": {
              "type": "object",
              "description": "The old name of props (accepted for one release)"
            },
            "pairs": {
              "type": "string",
              "description": "More prop=value words after the first, filling props",
              "rest": true
            },
            "prop": {
              "type": "string",
              "description": "The prop toggle flips; a prop=value word fills props (with value, the one-prop form props replaces)",
              "free": true,
              "pairs": true
            },
            "props": {
              "type": "object",
              "description": "The props to write: an object of prop (or @role: @label, @owner, @archive) to value, a subset or all of them; the others keep their values"
            },
            "toggle": {
              "type": "boolean",
              "description": "Flip the boolean prop instead of giving a value",
              "excludes": [
                "value"
              ]
            },
            "value": {
              "type": "any",
              "description": "The prop's new value, typed by the prop (a word such as 3, true or 400ms, a JSON array or object); props replaces it",
              "valueOf": "prop"
            }
          },
          "result": "JSON value",
          "disabled": true,
          "unavailable": "a system fact",
          "many": true,
          "positional": [
            "prop",
            "value",
            "pairs"
          ],
          "history": "change",
          "builtin": true,
          "standard": "set"
