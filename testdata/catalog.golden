              "free": true
            },
            "group-by": {
              "type": "string",
              "description": "Gather the rows that share these props' values into groups (comma-separated props); each row names its group",
              "free": true
            },
            "group-sort": {
              "type": "string",
              "description": "Order the groups by group-by props, each prop[:desc] (default: the order the groups first appear in)",
              "free": true
            },
            "limit": {
              "type": "integer",
              "description": "At most this many rows: the first page of that size (0: every row)"
