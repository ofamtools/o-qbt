            },
            "sort": {
              "type": "string",
              "description": "Order the rows by props, comma-separated, each prop[:desc]; ties keep the store's order",
              "free": true
            },
            "where": {
              "type": "string",
              "description": "prop=value pairs, comma- or space-separated: keep the things whose props equal every value",
              "free": true,
              "pairs": true
            }
          },
          "result": "rows",
          "disabled": true,
          "unavailable": "its store is a singleton; list is for a collection or instances",
          "rows": "ochazuke.state",
          "positional": [
            "limit",
            "props",
            "where"
          ],
          "history": "fetch",
          "builtin": true,
          "standard": "list"
