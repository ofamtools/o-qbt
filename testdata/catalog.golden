    {
      "name": "ochazuke.history",
      "kind": "collection",
      "props": [
        {
          "name": "seq",
          "type": "integer",
          "description": "The entry's number, in the order requests ran",
          "readOnly": true,
          "key": true,
          "human": true
        },
        {
          "name": "at",
          "type": "object",
          "description": "When it ran",
          "readOnly": true
        },
        {
          "name": "kind",
          "type": "string",
          "description": "action, change, fetch or system",
          "readOnly": true
        },
        {
          "name": "request",
          "type": "object",
          "description": "The request: noun, verb, arguments, target",
          "readOnly": true
        },
        {
          "name": "context",
          "type": "object",
          "description": "Where it ran: actor, focus, page, mode, source",
          "readOnly": true
        },
        {
          "name": "result",
          "type": "object",
          "description": "ok, or the error; the value when it is small",
          "readOnly": true
        },
        {
          "name": "moved",
          "type": "object",
          "description": "Where a motion moved the focus from and to",
          "readOnly": true
        },
        {
          "name": "job",
          "type": "integer",
          "description": "The job it started, when it ran off the loop",
          "readOnly": true
        },
        {
          "name": "depth",
          "type": "integer",
          "description": "How many requests enclose it (a choices source, a macro's keys)",
          "readOnly": true
        },
        {
          "name": "restored",
          "type": "boolean",
          "description": "Read from the history file at start: an earlier session ran it",
          "readOnly": true
        },
        {
          "name": "changes",
          "type": "object",
          "description": "What a standard write did to each thing, before and after",
          "readOnly": true
        },
