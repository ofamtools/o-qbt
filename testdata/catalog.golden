    {
      "name": "torrent",
      "kind": "collection",
      "props": [
        {
          "name": "hash",
          "type": "string",
          "description": "The torrent's info hash",
          "readOnly": true,
          "key": true
        },
        {
          "name": "name",
          "type": "string",
          "description": "The torrent's name",
          "readOnly": true,
          "role": "label"
        },
        {
          "name": "state",
          "type": "string",
          "description": "qBittorrent's state (downloading, stalledUP, pausedDL, error, missingFiles ...)",
          "readOnly": true
        },
        {
          "name": "progress",
          "type": "number",
          "description": "Fraction done, 0 to 1",
          "readOnly": true
        },
        {
          "name": "size",
          "type": "integer",
          "description": "Bytes",
          "readOnly": true
        },
        {
          "name": "dlspeed",
          "type": "integer",
          "description": "Download speed, bytes/s",
          "readOnly": true
        },
        {
          "name": "upspeed",
          "type": "integer",
          "description": "Upload speed, bytes/s",
          "readOnly": true
        },
        {
          "name": "eta",
          "type": "integer",
          "description": "Seconds left",
          "readOnly": true
        },
        {
          "name": "ratio",
          "type": "number",
          "description": "Share ratio",
          "readOnly": true
        },
        {
          "name": "category",
          "type": "string",
          "description": "The category",
          "readOnly": true
        },
        {
          "name": "tags",
          "type": "string",
          "description": "Comma-separated tags",
          "readOnly": true
